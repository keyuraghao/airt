define bot refuse to respond
  "I'm sorry, I can't respond to that."

define subflow airt jailbreak check
  """Blocks jailbreak personas (DAN, developer mode, unrestricted AI) using the offline regex heuristics in actions.py."""
  $airt_jailbreak = execute airt_check_jailbreak(text=$user_message)
  if $airt_jailbreak["blocked"]
    if $config.enable_rails_exceptions
      create event AirtJailbreakRailException(message=$airt_jailbreak["reason"])
    else
      bot refuse to respond
    stop

define subflow airt injection check
  """Blocks instruction override, delimiter spoofing and system prompt extraction attempts."""
  $airt_injection = execute airt_check_injection(text=$user_message)
  if $airt_injection["blocked"]
    if $config.enable_rails_exceptions
      create event AirtInjectionRailException(message=$airt_injection["reason"])
    else
      bot refuse to respond
    stop

define subflow airt output check
  """Blocks responses that leak a gateway canary token or credential material."""
  $airt_output = execute airt_check_output(text=$bot_message)
  if $airt_output["blocked"]
    if $config.enable_rails_exceptions
      create event AirtOutputRailException(message=$airt_output["reason"])
    else
      bot refuse to respond
    stop
