# AIRT gateway configuration. Copy to .env and edit. Every setting maps to a field in airt/config.py
# (prefix AIRT_, case insensitive). Environment variables override the .env file. Booleans accept
# true/false/1/0. Paths are relative to the working directory unless absolute.

# ----- service -----------------------------------------------------------------------------
# Display name used in the dashboard and the OpenAPI title.
AIRT_APP_NAME=AIRT Gateway
# development | staging | production. In production the console log switches to JSON lines.
AIRT_ENVIRONMENT=development
# Bind address and port for `airt serve`.
AIRT_HOST=0.0.0.0
AIRT_PORT=8080
# uvicorn worker processes. Keep 1 unless you understand the hold registry limitation (README > Limitations):
# the in-process fast path only resolves waiting requests decided in the same process, other
# processes fall back to DB polling every AIRT_HOLD_POLL_INTERVAL_SECONDS.
AIRT_WORKERS=1
# Base directory (defaults to the current working directory).
#AIRT_BASE_DIR=/app
# Where the SQLite database and other state live (created on start).
AIRT_DATA_DIR=./data
# Where logs/airt.jsonl and logs/agents/<agent_id>.jsonl are written (created on start).
AIRT_LOG_DIR=./logs
# DEBUG | INFO | WARNING | ERROR
AIRT_LOG_LEVEL=INFO
# Emit JSON lines on stdout instead of the coloured console renderer (recommended in containers).
AIRT_LOG_JSON_CONSOLE=false

# ----- persistence -------------------------------------------------------------------------
# SQLAlchemy async URL. SQLite (default) or PostgreSQL with the asyncpg driver (pip install "airt[postgres]").
AIRT_DATABASE_URL=sqlite+aiosqlite:///./data/airt.db
#AIRT_DATABASE_URL=postgresql+asyncpg://airt:airt@localhost:5432/airt
# Log every SQL statement.
AIRT_DB_ECHO=false

# ----- security ----------------------------------------------------------------------------
# Signs reviewer session cookies and (when AIRT_ENCRYPTION_KEY is unset) derives the Fernet key that
# encrypts upstream provider credentials. Minimum 16 characters. CHANGE IT: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRT_SECRET_KEY=change-me-in-production-please-0123456789
# Optional explicit Fernet key for upstream credentials (base64, 32 bytes). Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you rotate AIRT_SECRET_KEY without setting this, stored upstream keys can no longer be decrypted.
#AIRT_ENCRYPTION_KEY=
# The initial admin reviewer, created on first start if missing. A warning is logged while the password is "admin".
AIRT_ADMIN_USERNAME=admin
AIRT_ADMIN_PASSWORD=admin
# Static bearer token with admin role for automation: the MCP server, `airt` CLI, CI, curl.
# Send as `Authorization: Bearer <token>` or `X-AIRT-Admin-Token: <token>`.
#AIRT_ADMIN_API_TOKEN=
# Dashboard session lifetime (seconds). Default 12 hours.
AIRT_SESSION_MAX_AGE_SECONDS=43200
# Set the Secure flag on the session cookie (enable behind HTTPS).
AIRT_COOKIE_SECURE=false

# ----- notifications -----------------------------------------------------------------------
# JSON list of webhook URLs paged on ticket events. Slack incoming webhooks get Block Kit messages,
# any other URL receives the raw event JSON. Empty list disables notifications.
AIRT_NOTIFY_WEBHOOK_URLS=[]
#AIRT_NOTIFY_WEBHOOK_URLS=["https://hooks.slack.com/services/T000/B000/XXXX"]
# Ticket events that trigger a notification (JSON list): created, decided, completed, expired, failed.
AIRT_NOTIFY_EVENTS=["created","expired","failed"]
# Only notify for tickets with risk_score at or above this value.
AIRT_NOTIFY_MIN_RISK=0
# Externally reachable base URL used for the "Open ticket" links in notifications (defaults to http://localhost:<port>).
#AIRT_PUBLIC_URL=https://airt.example.com

# ----- gateway behaviour -------------------------------------------------------------------
# How long a synchronous request (no X-AIRT-Async header) blocks waiting for a human decision before
# the ticket becomes EXPIRED and the client receives 504. Also the expires_at of async tickets.
AIRT_APPROVAL_TIMEOUT_SECONDS=300
# DB polling interval used while waiting, for decisions made in another process (MCP, second worker).
AIRT_HOLD_POLL_INTERVAL_SECONDS=1.0
# Requests larger than this are rejected with 413 before analysis. Default 4 MiB.
AIRT_MAX_REQUEST_BODY_BYTES=4194304
# Maximum upstream response bytes stored on the ticket (streams are captured up to this size). Default 512 KiB.
AIRT_MAX_STORED_RESPONSE_BYTES=524288
# Upstream (provider) read timeout and connect timeout in seconds.
AIRT_UPSTREAM_TIMEOUT_SECONDS=120
AIRT_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
# Default risk thresholds for new agents (each agent stores its own copy; edit per agent afterwards).
# Risk score >= auto-deny threshold -> DENIED without human review.
AIRT_DEFAULT_AUTO_DENY_RISK_THRESHOLD=90
# Risk score < auto-approve threshold -> APPROVED without human review. 0 disables auto-approval.
AIRT_DEFAULT_AUTO_APPROVE_RISK_THRESHOLD=0
# Tickets older than this many days are purged by the background sweeper (0 keeps everything).
AIRT_TICKET_RETENTION_DAYS=90
# Red-team probes go through the same human hold as any other ticket. Set false to let campaigns
# run unattended (probes are still analysed, logged and audited).
AIRT_REQUIRE_APPROVAL_FOR_REDTEAM_PROBES=true

# ----- analysis ----------------------------------------------------------------------------
# Enable the optional LLM judge analyzer (uses an LLM to grade prompts/responses in addition to the rule based analyzers).
AIRT_ENABLE_LLM_JUDGE=false
# openai | anthropic
AIRT_JUDGE_PROVIDER=openai
# Base URL and key for the judge model (independent from any agent's upstream credentials).
#AIRT_JUDGE_BASE_URL=https://api.openai.com/v1
#AIRT_JUDGE_API_KEY=
AIRT_JUDGE_MODEL=gpt-4o-mini

# ----- red team ----------------------------------------------------------------------------
# Probes submitted in parallel by a running campaign.
AIRT_REDTEAM_CONCURRENCY=4
# Per-probe wait (seconds) for approval + upstream answer before the probe is marked ERROR.
AIRT_REDTEAM_PROBE_TIMEOUT_SECONDS=90

# ----- docker-compose only (not read by the application) -----------------------------------
# Host interface the compose file publishes the port on (127.0.0.1 keeps it local; 0.0.0.0 exposes it).
AIRT_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=airt
POSTGRES_PASSWORD=airt
POSTGRES_DB=airt
